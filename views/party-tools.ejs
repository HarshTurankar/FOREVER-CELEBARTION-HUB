<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Party Tools | Birthday Vibes</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #fff8fb;
            color: #333;
        }

        .hero {
            text-align: center;
            padding: 60px 20px 50px;
            background: linear-gradient(135deg, #fff0f6, #ffffff);
        }

        .hero h1 {
            color: #ff3d81;
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 700px;
            margin: auto;
            color: #666;
            font-size: 17px;
            line-height: 1.6;
        }

        .tools {
            width: 90%;
            max-width: 1100px;
            margin: 50px auto 70px;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .tool-card {
            background: white;
            padding: 30px 25px;
            text-align: center;
            border-radius: 16px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .tool-card:hover {
            transform: translateY(-6px);
        }

        .icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .tool-card h2 {
            color: #ff3d81;
            font-size: 21px;
            margin-bottom: 10px;
        }

        .tool-card p {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
        }

        .checklist {
            width: 90%;
            max-width: 850px;
            margin: 0 auto 70px;

            background: white;
            padding: 35px;
            border-radius: 16px;

            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
        }

        .checklist h2 {
            text-align: center;
            color: #ff3d81;
            margin-bottom: 25px;
        }

        .task {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 14px;
            margin-bottom: 10px;

            background: #fff7fa;
            border-radius: 8px;
        }

        .task input {
            width: 18px;
            height: 18px;
            accent-color: #ff3d81;
        }

        .task label {
            color: #555;
        }

        .cta {
            background: #ff3d81;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .cta h2 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .cta p {
            margin-bottom: 20px;
        }

        @media (max-width: 900px) {
            .tools {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 32px;
            }

            .tools {
                grid-template-columns: 1fr;
            }

            .checklist {
                padding: 25px;
            }
        }
    </style>
</head>

<body>

    <!-- HERO -->

    <section class="hero">

        <h1>Birthday Party Tools 🎂</h1>

        <p>
            Plan your perfect birthday celebration with simple
            tools to organize your budget, guests, theme and party details.
        </p>

    </section>


    <!-- TOOLS -->

    <section class="tools">

        <div class="tool-card">

            <div class="icon">💰</div>

            <h2>Budget Planner</h2>

            <p>
                Keep track of your birthday party expenses
                and plan everything according to your budget.
            </p>

        </div>


        <div class="tool-card">

            <div class="icon">👥</div>

            <h2>Guest List</h2>

            <p>
                Organize your guests and make sure nobody
                is missed from your celebration.
            </p>

        </div>


        <div class="tool-card">

            <div class="icon">🎨</div>

            <h2>Party Theme</h2>

            <p>
                Choose a fun birthday theme based on your
                age, interests and celebration style.
            </p>

        </div>


        <div class="tool-card">

            <div class="icon">🍰</div>

            <h2>Cake Planner</h2>

            <p>
                Plan your cake design, flavor, size and
                special birthday message.
            </p>

        </div>


        <div class="tool-card">

            <div class="icon">🎵</div>

            <h2>Entertainment</h2>

            <p>
                Plan music, games and entertainment activities
                to keep your guests enjoying the party.
            </p>

        </div>


        <div class="tool-card">

            <div class="icon">📋</div>

            <h2>Party Checklist</h2>

            <p>
                Keep all your important birthday preparation
                tasks organized in one place.
            </p>

        </div>

    </section>


    <!-- CHECKLIST -->

    <section class="checklist">

        <h2>Birthday Party Checklist ✅</h2>

        <div class="task">
            <input type="checkbox" id="task1">
            <label for="task1">Choose Birthday Date</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task2">
            <label for="task2">Set Party Budget</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task3">
            <label for="task3">Choose Party Theme</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task4">
            <label for="task4">Prepare Guest List</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task5">
            <label for="task5">Order Birthday Cake</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task6">
            <label for="task6">Arrange Decorations</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task7">
            <label for="task7">Arrange Music & Games</label>
        </div>

        <div class="task">
            <input type="checkbox" id="task8">
            <label for="task8">Send Invitations</label>
        </div>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>Make Your Birthday Unforgettable 🎉</h2>

        <p>
            Choose a birthday package and start planning your celebration.
        </p>

    </section>

</body>
</html>