<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Birthday Packages | Birthday Vibes</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #fff8fb;
            color: #333;
        }

        .hero {
            text-align: center;
            padding: 60px 20px 50px;
            background: linear-gradient(135deg, #fff0f6, #ffffff);
        }

        .hero h1 {
            color: #ff3d81;
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 700px;
            margin: auto;
            color: #666;
            font-size: 17px;
            line-height: 1.6;
        }

        .packages {
            width: 90%;
            max-width: 1150px;
            margin: 50px auto 70px;

            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .package-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: 0.3s;
            position: relative;
        }

        .package-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

        .package-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
        }

        .popular {
            position: absolute;
            top: 15px;
            right: 15px;

            background: #ff3d81;
            color: white;

            padding: 6px 12px;
            border-radius: 20px;

            font-size: 12px;
            font-weight: bold;
        }

        .content {
            padding: 22px;
        }

        .content h2 {
            color: #ff3d81;
            font-size: 21px;
            margin-bottom: 10px;
        }

        .price {
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .price span {
            font-size: 13px;
            color: #888;
            font-weight: normal;
        }

        .features {
            list-style: none;
            margin-bottom: 22px;
        }

        .features li {
            color: #555;
            font-size: 14px;
            margin: 11px 0;
        }

        .features li::before {
            content: "✓";
            color: #ff3d81;
            font-weight: bold;
            margin-right: 8px;
        }

        .book-btn {
            display: block;
            text-align: center;
            background: #ff3d81;
            color: white;
            text-decoration: none;
            padding: 11px;
            border-radius: 8px;
            font-weight: bold;
        }

        .book-btn:hover {
            background: #e52d6d;
        }

        .custom {
            width: 90%;
            max-width: 950px;
            margin: 0 auto 70px;

            background: white;
            padding: 40px;

            text-align: center;
            border-radius: 16px;

            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
        }

        .custom h2 {
            color: #ff3d81;
            margin-bottom: 12px;
        }

        .custom p {
            color: #666;
            line-height: 1.6;
        }

        .cta {
            background: #ff3d81;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .cta h2 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .cta p {
            margin-bottom: 10px;
        }

        @media (max-width: 1000px) {
            .packages {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 32px;
            }

            .packages {
                grid-template-columns: 1fr;
            }

            .custom {
                padding: 28px;
            }
        }
    </style>
</head>

<body>

    <!-- HERO -->

    <section class="hero">

        <h1>Birthday Packages 🎂</h1>

        <p>
            Choose the perfect birthday package and celebrate
            your special day with decorations, cake, entertainment
            and unforgettable moments.
        </p>

    </section>


    <!-- PACKAGES -->

    <section class="packages">

        <!-- Kids -->

        <div class="package-card">

            <img
                src="/images/birthday-kids.jpg"
                alt="Kids Birthday"
            >

            <div class="content">

                <h2>Kids Fun Party 🎈</h2>

                <div class="price">
                    ₹4,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Theme Decoration</li>
                    <li>Birthday Cake</li>
                    <li>Balloons</li>
                    <li>Party Games</li>
                    <li>Music & Sound</li>
                </ul>

                <a href="/birthday-packages"
                   class="book-btn">
                    Select Package
                </a>

            </div>

        </div>


        <!-- Popular -->

        <div class="package-card">

            <div class="popular">
                MOST POPULAR
            </div>

            <img
                src="/images/birthday-premium.jpg"
                alt="Premium Birthday"
            >

            <div class="content">

                <h2>Premium Celebration 🎉</h2>

                <div class="price">
                    ₹9,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Premium Decoration</li>
                    <li>Designer Birthday Cake</li>
                    <li>Photography</li>
                    <li>DJ & Music</li>
                    <li>Party Games</li>
                    <li>Return Gifts</li>
                </ul>

                <a href="/birthday-packages"
                   class="book-btn">
                    Select Package
                </a>

            </div>

        </div>


        <!-- Theme -->

        <div class="package-card">

            <img
                src="/images/birthday-theme.jpg"
                alt="Theme Birthday"
            >

            <div class="content">

                <h2>Theme Party 🌟</h2>

                <div class="price">
                    ₹14,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Custom Theme Decoration</li>
                    <li>Premium Cake</li>
                    <li>Photo Booth</li>
                    <li>DJ & Entertainment</li>
                    <li>Professional Photography</li>
                    <li>Party Games</li>
                </ul>

                <a href="/birthday-packages"
                   class="book-btn">
                    Select Package
                </a>

            </div>

        </div>


        <!-- Luxury -->

        <div class="package-card">

            <img
                src="/images/birthday-luxury.jpg"
                alt="Luxury Birthday"
            >

            <div class="content">

                <h2>Luxury Birthday ✨</h2>

                <div class="price">
                    ₹24,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Luxury Venue Decoration</li>
                    <li>Premium Cake</li>
                    <li>Professional Photo & Video</li>
                    <li>DJ & Entertainment</li>
                    <li>Special Entry</li>
                    <li>Complete Party Management</li>
                </ul>

                <a href="/birthday-packages"
                   class="book-btn">
                    Select Package
                </a>

            </div>

        </div>

    </section>


    <!-- CUSTOM -->

    <section class="custom">

        <h2>Create Your Own Birthday Package ❤️</h2>

        <p>
            Want something different? Combine your favorite
            decoration, cake, entertainment and photography
            options to create your perfect celebration.
        </p>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>Make Your Birthday Unforgettable 🎂</h2>

        <p>
            Choose a package that matches your celebration style.
        </p>

    </section>

</body>
</html>