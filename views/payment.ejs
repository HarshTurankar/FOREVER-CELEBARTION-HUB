<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Payment Page</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      background-color: #f4f4f9;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      padding: 16px;
    }
    .card {
      padding: 26px;
      border-radius: 14px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
      background: #fff;
      width: 100%;
      max-width: 420px;
    }
    h3 { font-weight: 600; margin-bottom: 8px; }
    p.lead { margin-bottom: 18px; color: #666; }

    .amount {
      font-size: 1.15rem;
      font-weight: 700;
      color: #28a745;
      margin-bottom: 16px;
    }

    .payment-option {
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid #e6e9ee;
      padding: 10px 12px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.18s ease;
      margin-top: 10px;
    }
    .payment-option input[type="radio"] {
      width: 18px;
      height: 18px;
      margin: 0;
    }
    .payment-option:hover { transform: translateY(-3px); box-shadow: 0 8px 18px rgba(0,0,0,0.04); }
    .ico-box {
      width: 44px; height: 36px; display:flex; align-items:center; justify-content:center;
      background:#fff; border-radius:8px;
      border:1px solid #f0f0f0;
    }
    .ico-label { font-weight: 500; color:#222; }

    .pw-row { margin-top: 16px; text-align:left; }
    .pw-row label { font-size: 0.95rem; font-weight: 600; }
    .pw-row .form-control { border-radius: 8px; padding: 10px 12px; }

    .help { font-size: 0.9rem; color:#666; margin-top: 8px; }

    .btn-pay { width: 100%; margin-top: 18px; border-radius: 10px; padding: 10px 14px; font-size: 1rem; }
    .error { color: #b02a37; font-weight: 600; margin-top: 10px; display: none; }

    @media (max-width:420px){
      .card { padding: 20px; }
      .ico-box { width:38px; height:30px; }
    }
  </style>
</head>
<body>
  <div class="card">
    <h3>💳 Secure Payment</h3>
    <p class="lead">Choose a payment method and confirm with your password</p>

    <p class="amount">
  Total Amount: ₹<span id="totalAmount"><%= total || 0 %></span>
</p>

    <form id="paymentForm" action="/payment-success" method="POST" novalidate>

      <!-- Credit/Debit Card -->
      <label class="payment-option" for="m_card">
        <input id="m_card" type="radio" name="method" value="card" required>
        <div class="ico-box" aria-hidden="true">
          <i class="bi bi-credit-card-fill text-primary fs-4"></i>
        </div>
        <div class="ico-label">Credit / Debit Card</div>
      </label>

      <!-- PhonePe -->
      <label class="payment-option" for="m_phonepe">
        <input id="m_phonepe" type="radio" name="method" value="phonepe">
        <div class="ico-box" aria-hidden="true">
          <img src="https://upload.wikimedia.org/wikipedia/commons/f/f0/PhonePe_Logo.png" alt="PhonePe" width="38">
        </div>
        <div class="ico-label">PhonePe / UPI</div>
      </label>

      <!-- Paytm -->
      <label class="payment-option" for="m_paytm">
        <input id="m_paytm" type="radio" name="method" value="paytm">
        <div class="ico-box" aria-hidden="true">
          <img src="https://upload.wikimedia.org/wikipedia/commons/5/55/Paytm_logo.png" alt="Paytm" width="45">
        </div>
        <div class="ico-label">Paytm</div>
      </label>

      <!-- Google Pay -->
      <label class="payment-option" for="m_gpay">
        <input id="m_gpay" type="radio" name="method" value="gpay">
        <div class="ico-box" aria-hidden="true">
          <img src="https://upload.wikimedia.org/wikipedia/commons/5/5a/Google_Pay_Logo.svg" alt="GPay" width="42">
        </div>
        <div class="ico-label">Google Pay</div>
      </label>

      <!-- Password -->
      <div class="pw-row">
        <label for="payPassword">Payment Password</label>
        <input id="payPassword" name="payPassword" type="password" class="form-control" placeholder="Enter payment password" required>
        <small class="help">Use password <strong>pay123</strong> to simulate success.</small>
      </div>

      <div class="error" id="errorMsg">Invalid password or select a payment method.</div>

      <button type="submit" id="payBtn" class="btn btn-success btn-pay">Proceed to Pay</button>
    </form>
  </div>

  <script>
    (function(){
      const form = document.getElementById('paymentForm');
      const passInput = document.getElementById('payPassword');
      const err = document.getElementById('errorMsg');

      form.addEventListener('submit', function(e){
        e.preventDefault();
        err.style.display = 'none';

        const method = form.method.value;
        const pw = passInput.value.trim();

        if (!method) {
          err.textContent = 'Please select a payment method.';
          err.style.display = 'block';
          return;
        }

        if (!pw) {
          err.textContent = 'Payment password is required.';
          err.style.display = 'block';
          passInput.focus();
          return;
        }

        const DEMO_PW = 'pay123';
        if (pw !== DEMO_PW) {
          err.textContent = 'Invalid payment password.';
          err.style.display = 'block';
          passInput.focus();
          return;
        }

        const btn = document.getElementById('payBtn');
        btn.disabled = true;
        btn.textContent = 'Processing...';

        setTimeout(() => {
          form.submit();
        }, 1000);
      });
    })();
  </script>
</body>
</html>
