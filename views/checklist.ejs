<!DOCTYPE html>
<html>
<head>
  <title>Hall Bookings</title>
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
    }
    h2 {
      text-align: center;
      margin: 20px 0;
    }
    #calendar {
      max-width: 800px;
      margin: auto;
    }
  </style>
</head>
<body>
  <h2>📅 Booked Dates for This Hall</h2>

  <!-- 📅 Calendar Container -->
  <div id="calendar"></div>
<script>
  const urlParams = new URLSearchParams(window.location.search);
  const hallId ='1';

  if (!hallId) {
    alert("❌ Hall ID missing in URL");
    throw new Error("Hall ID not found in URL");
  }

  let calendar;

  document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');

    calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      events: []
    });

    calendar.render();
    loadBookedDates(hallId);
  });

  function loadBookedDates(hallId) {
    fetch(`/api/booked-dates/${hallId}`)
      .then(res => res.json())
      .then(bookedDates => {
        const events = bookedDates.map(date => ({
          title: 'Booked',
          start: date,
          color: '#dc3545'
        }));

        calendar.removeAllEvents();
        events.forEach(event => calendar.addEvent(event));
      })
      .catch(err => {
        console.error("Error loading booked dates:", err);
      });
  }
</script>

</body>
</html>
