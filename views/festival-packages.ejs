<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Festival Packages | Festival Events</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #fffaf5;
            color: #333;
        }

        .hero {
            text-align: center;
            padding: 60px 20px 50px;
            background: linear-gradient(135deg, #fff3e0, #ffffff);
        }

        .hero h1 {
            color: #ff7900;
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 720px;
            margin: auto;
            color: #666;
            font-size: 17px;
            line-height: 1.6;
        }

        .packages {
            width: 90%;
            max-width: 1150px;
            margin: 50px auto 70px;

            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .package-card {
            position: relative;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .package-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

        .package-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
        }

        .popular {
            position: absolute;
            top: 15px;
            right: 15px;

            background: #ff7900;
            color: white;

            padding: 6px 12px;
            border-radius: 20px;

            font-size: 12px;
            font-weight: bold;
        }

        .content {
            padding: 22px;
        }

        .content h2 {
            color: #ff7900;
            font-size: 21px;
            margin-bottom: 10px;
        }

        .price {
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .price span {
            font-size: 13px;
            color: #888;
            font-weight: normal;
        }

        .features {
            list-style: none;
            margin-bottom: 22px;
        }

        .features li {
            color: #555;
            font-size: 14px;
            margin: 11px 0;
        }

        .features li::before {
            content: "✓";
            color: #ff7900;
            font-weight: bold;
            margin-right: 8px;
        }

        .select-btn {
            display: block;
            text-align: center;
            background: #ff7900;
            color: white;
            text-decoration: none;
            padding: 11px;
            border-radius: 8px;
            font-weight: bold;
        }

        .select-btn:hover {
            background: #df6500;
        }

        .custom {
            width: 90%;
            max-width: 950px;
            margin: 0 auto 70px;

            background: white;
            padding: 40px;

            text-align: center;
            border-radius: 16px;

            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
        }

        .custom h2 {
            color: #ff7900;
            margin-bottom: 12px;
        }

        .custom p {
            color: #666;
            line-height: 1.6;
        }

        .cta {
            background: #ff7900;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .cta h2 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .cta p {
            font-size: 16px;
        }

        @media (max-width: 1000px) {
            .packages {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 32px;
            }

            .packages {
                grid-template-columns: 1fr;
            }

            .custom {
                padding: 28px;
            }
        }
    </style>
</head>

<body>

    <!-- HERO -->

    <section class="hero">

        <h1>Festival Packages 🎊</h1>

        <p>
            Choose the perfect celebration package for your
            festival and enjoy decorations, lighting,
            entertainment and more.
        </p>

    </section>


    <!-- PACKAGES -->

    <section class="packages">

        <!-- DIWALI -->

        <div class="package-card">

            <img
                src="/images/package-diwali.jpg"
                alt="Diwali Package"
            >

            <div class="content">

                <h2>Diwali Celebration 🪔</h2>

                <div class="price">
                    ₹7,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Traditional Decoration</li>
                    <li>Rangoli Setup</li>
                    <li>Decorative Lighting</li>
                    <li>Flower Decoration</li>
                    <li>Music & Sound</li>
                </ul>

                <a href="/festival-packages" class="select-btn">
                    Select Package
                </a>

            </div>

        </div>


        <!-- HOLI -->

        <div class="package-card">

            <div class="popular">
                MOST POPULAR
            </div>

            <img
                src="/images/package-holi.jpg"
                alt="Holi Package"
            >

            <div class="content">

                <h2>Holi Celebration 🎨</h2>

                <div class="price">
                    ₹6,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Colorful Theme Decoration</li>
                    <li>DJ & Music</li>
                    <li>Holi Colors</li>
                    <li>Fun Games</li>
                    <li>Food & Refreshments</li>
                </ul>

                <a href="/festival-packages" class="select-btn">
                    Select Package
                </a>

            </div>

        </div>


        <!-- GANESH -->

        <div class="package-card">

            <img
                src="/images/package-ganesh.jpg"
                alt="Ganesh Utsav Package"
            >

            <div class="content">

                <h2>Ganesh Utsav 🌺</h2>

                <div class="price">
                    ₹9,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Traditional Stage Decor</li>
                    <li>Floral Decoration</li>
                    <li>Lighting Setup</li>
                    <li>Sound System</li>
                    <li>Event Arrangement</li>
                </ul>

                <a href="/festival-packages" class="select-btn">
                    Select Package
                </a>

            </div>

        </div>


        <!-- CHRISTMAS -->

        <div class="package-card">

            <img
                src="/images/package-christmas.jpg"
                alt="Christmas Package"
            >

            <div class="content">

                <h2>Christmas Celebration 🎄</h2>

                <div class="price">
                    ₹8,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Christmas Tree Setup</li>
                    <li>Fairy Lights</li>
                    <li>Festive Decoration</li>
                    <li>Music & Entertainment</li>
                    <li>Photo Corner</li>
                </ul>

                <a href="/festival-packages" class="select-btn">
                    Select Package
                </a>

            </div>

        </div>

    </section>


    <!-- CUSTOM -->

    <section class="custom">

        <h2>Create Your Custom Festival Package ✨</h2>

        <p>
            Combine decorations, lighting, music and entertainment
            according to your festival and celebration requirements.
        </p>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>Celebrate Every Festival in Style 🎉</h2>

        <p>
            Choose a package and make your celebration memorable.
        </p>

    </section>

</body>
</html>