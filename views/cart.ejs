<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart | Wedding Planner</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      background: linear-gradient(to right, #f8f9fa, #fff);
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      padding-top: 60px;
    }

    .container {
      max-width: 950px;
    }

    .cart-card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
      background-color: #ffffff;
      padding: 40px;
      position: relative;
      transition: transform 0.2s ease;
    }

    .cart-card:hover {
      transform: translateY(-4px);
    }

    h2 {
      font-weight: 600;
      color: #343a40;
    }

    table {
      border-radius: 12px;
      overflow: hidden;
    }

    .table th {
      background-color: #212529;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.9rem;
    }

    .table td {
      vertical-align: middle;
      text-align: center;
      font-size: 1rem;
      color: #495057;
    }

    .btn-remove {
      background-color: #dc3545;
      color: white;
      border-radius: 6px;
      font-size: 0.85rem;
      padding: 5px 12px;
      border: none;
      transition: background 0.3s ease;
    }

    .btn-remove:hover {
      background-color: #b02a37;
    }

    .btn-payment {
      background: linear-gradient(to right, #198754, #0d6efd);
      border: none;
      color: white;
      font-size: 1.1rem;
      font-weight: 500;
      border-radius: 10px;
      padding: 12px 40px;
      box-shadow: 0 4px 12px rgba(25,135,84,0.3);
      transition: all 0.3s ease;
    }

    .btn-payment:hover {
      background: linear-gradient(to right, #157347, #0b5ed7);
      transform: translateY(-2px);
    }

    /* ✅ Home Button (fixed top-right corner) */
    .home-btn {
      position: fixed;
      top: 20px;
      right: 30px;
      background: linear-gradient(to right, #ff4081, #d63384);
      color: #fff;
      padding: 10px 18px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 500;
      box-shadow: 0 4px 12px rgba(214,51,132,0.3);
      transition: all 0.3s ease;
    }

    .home-btn:hover {
      background: linear-gradient(to right, #e91e63, #c2185b);
      transform: translateY(-2px);
    }

    /* Empty cart message */
    .empty-msg {
      font-size: 1.1rem;
      color: #6c757d;
      margin-bottom: 20px;
    }
  </style>
</head>

<body>

  <!-- ✅ Home Button -->
  <a href="/home" class="home-btn">
    <i class="fa-solid fa-house"></i> Home
  </a>

  <%
let totalAmount = 0;
cart.forEach(item => {
totalAmount += Number(item.price || 0);
});
%>

<div class="container mt-4 mb-5">
  <div class="cart-card">

```
<h2 class="text-center mb-4">🛒 Your Selected Items</h2>

<% if (cart.length === 0) { %>

  <div class="alert alert-info text-center p-4">
    <div class="empty-msg">Your cart is empty.</div>

    <a href="/home" class="btn btn-primary px-4 py-2">
      Go Back & Add Items
    </a>
  </div>

<% } else { %>

  <div class="table-responsive">
    <table class="table table-bordered align-middle mb-4">

      <thead>
        <tr>
          <th>Type</th>
          <th>Name</th>
          <th>Price (₹)</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% cart.forEach((item, index) => { %>

          <tr>
            <td>
              <span class="badge bg-primary">
                <%= item.type || 'Venue' %>
              </span>
            </td>

            <td>
              <%= item.name %>
            </td>

            <td>
              <strong>
                ₹<%= Number(item.price || 0).toLocaleString() %>
              </strong>
            </td>

            <td>
              <form action="/remove-from-cart" method="POST">
                <input
                  type="hidden"
                  name="index"
                  value="<%= index %>"
                >

                <button
                  type="submit"
                  class="btn btn-danger"
                >
                  Remove
                </button>
              </form>
            </td>
          </tr>

        <% }) %>
      </tbody>

    </table>
  </div>

  <div class="text-end mb-4">
    <h3>
      Total Amount:
      <span class="text-success">
        ₹<%= totalAmount.toLocaleString() %>
      </span>
    </h3>
  </div>

  <div class="d-flex justify-content-center">
    <a href="/payment" class="btn btn-success btn-lg">
      Proceed to Secure Payment 💳
    </a>
  </div>

<% } %>
```

  </div>
</div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://kit.fontawesome.com/a2e0c1d2b0.js" crossorigin="anonymous"></script>

</body>
</html>
