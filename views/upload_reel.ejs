<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Upload Reel</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    body {
      background: linear-gradient(135deg, #f8f9fa, #ffffff);
      font-family: 'Poppins', sans-serif;
    }

    .upload-container {
      max-width: 600px;
      margin: 80px auto;
      background: #fff;
      border-radius: 15px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.1);
      padding: 30px;
    }

    h2 {
      text-align: center;
      font-weight: 600;
      color: #333;
      margin-bottom: 30px;
    }

    .form-control {
      border-radius: 10px;
    }

    .btn-upload {
      background: linear-gradient(to right, #0d6efd, #198754);
      color: white;
      border: none;
      padding: 10px 25px;
      border-radius: 10px;
      font-weight: 500;
      width: 100%;
      transition: all 0.3s ease;
    }

    .btn-upload:hover {
      background: linear-gradient(to right, #0b5ed7, #146c43);
      transform: translateY(-2px);
    }

    .back-btn {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: #0d6efd;
      text-decoration: none;
      font-weight: 500;
    }

    .back-btn:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <div class="upload-container">
    <h2>🎬 Upload New Reel</h2>

    <form action="/upload-reel" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="caption" class="form-label">Reel Caption</label>
        <input type="text" name="caption" id="caption" class="form-control" placeholder="Write something..." required>
      </div>

      <div class="mb-3">
        <label for="video" class="form-label">Select Video File</label>
        <input type="file" name="video" id="video" accept="video/*" class="form-control" required>
      </div>

      <button type="submit" class="btn-upload">Upload Reel 🚀</button>
    </form>

    <a href="/reels" class="back-btn">⬅ Back to Reels</a>
  </div>

</body>
</html>
