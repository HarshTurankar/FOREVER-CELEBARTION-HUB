<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Catering & Music | Custom Events Hub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f7faff;
            color: #333;
        }

        .hero {
            text-align: center;
            padding: 60px 20px 50px;
            background: linear-gradient(135deg, #eef6ff, #ffffff);
        }

        .hero h1 {
            color: #0879ff;
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 720px;
            margin: auto;
            color: #666;
            font-size: 17px;
            line-height: 1.6;
        }

        .services {
            width: 90%;
            max-width: 1150px;
            margin: 50px auto 70px;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .service-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .service-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

        .service-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .content {
            padding: 20px;
        }

        .content h2 {
            color: #0879ff;
            font-size: 21px;
            margin-bottom: 10px;
        }

        .content p {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .price {
            font-size: 21px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .select-btn {
            display: block;
            text-align: center;
            background: #0879ff;
            color: white;
            text-decoration: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: bold;
        }

        .select-btn:hover {
            background: #0665d8;
        }

        .cta {
            background: #0879ff;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .cta h2 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .cta p {
            font-size: 16px;
        }

        @media (max-width: 900px) {
            .services {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 32px;
            }

            .services {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- HERO -->

    <section class="hero">

        <h1>Catering & Music 🍽️🎶</h1>

        <p>
            Complete your event with delicious food, professional
            catering and great music for an unforgettable experience.
        </p>

    </section>


    <!-- SERVICES -->

    <section class="services">

        <!-- Catering -->

        <div class="service-card">

            <img
                src="/images/event-catering.jpg"
                alt="Event Catering"
            >

            <div class="content">

                <h2>Event Catering 🍽️</h2>

                <p>
                    Delicious menus and professional catering
                    services for small and large events.
                </p>

                <div class="price">
                    ₹499 / person
                </div>

                <a href="/catering-music" class="select-btn">
                    Select
                </a>

            </div>

        </div>


        <!-- Premium Catering -->

        <div class="service-card">

            <img
                src="/images/premium-catering.jpg"
                alt="Premium Catering"
            >

            <div class="content">

                <h2>Premium Catering ⭐</h2>

                <p>
                    Premium food options with elegant presentation
                    and professional service.
                </p>

                <div class="price">
                    ₹799 / person
                </div>

                <a href="/catering-music" class="select-btn">
                    Select
                </a>

            </div>

        </div>


        <!-- DJ -->

        <div class="service-card">

            <img
                src="/images/event-dj.jpg"
                alt="Event DJ"
            >

            <div class="content">

                <h2>Professional DJ 🎧</h2>

                <p>
                    Energetic music and professional DJ setup
                    for parties and celebrations.
                </p>

                <div class="price">
                    ₹4,999
                </div>

                <a href="/catering-music" class="select-btn">
                    Select
                </a>

            </div>

        </div>


        <!-- Sound -->

        <div class="service-card">

            <img
                src="/images/event-sound.jpg"
                alt="Sound System"
            >

            <div class="content">

                <h2>Sound System 🔊</h2>

                <p>
                    High-quality speakers, microphones and
                    complete sound setup for your event.
                </p>

                <div class="price">
                    ₹3,499
                </div>

                <a href="/catering-music" class="select-btn">
                    Select
                </a>

            </div>

        </div>


        <!-- Live Band -->

        <div class="service-card">

            <img
                src="/images/live-band.jpg"
                alt="Live Band"
            >

            <div class="content">

                <h2>Live Band 🎸</h2>

                <p>
                    Professional musicians and live performances
                    to create an energetic atmosphere.
                </p>

                <div class="price">
                    ₹9,999
                </div>

                <a href="/catering-music" class="select-btn">
                    Select
                </a>

            </div>

        </div>


        <!-- Mocktail -->

        <div class="service-card">

            <img
                src="/images/mocktail-counter.jpg"
                alt="Mocktail Counter"
            >

            <div class="content">

                <h2>Mocktail Counter 🍹</h2>

                <p>
                    Refreshing mocktails and beverages with
                    an attractive live serving counter.
                </p>

                <div class="price">
                    ₹2,999
                </div>

                <a href="/catering-music" class="select-btn">
                    Select
                </a>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>Complete Your Perfect Event 💙</h2>

        <p>
            Great food and great music make every celebration better.
        </p>

    </section>

</body>
</html>