<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wedding Packages | Wedding Planner</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #fff8fc;
            color: #333;
        }

        /* HERO */

        .hero {
            text-align: center;
            padding: 60px 20px 50px;
            background: linear-gradient(135deg, #fff0f7, #ffffff);
        }

        .hero h1 {
            color: #d62f83;
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 720px;
            margin: auto;
            color: #666;
            font-size: 17px;
            line-height: 1.6;
        }

        /* PACKAGES */

        .packages {
            width: 90%;
            max-width: 1200px;
            margin: 50px auto 70px;

            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .package-card {
            position: relative;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .package-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.13);
        }

        .package-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
        }

        .popular {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #d62f83;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .package-content {
            padding: 22px;
        }

        .package-content h2 {
            color: #d62f83;
            font-size: 22px;
            margin-bottom: 10px;
        }

        .price {
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .price span {
            font-size: 13px;
            color: #888;
            font-weight: normal;
        }

        .features {
            list-style: none;
            margin-bottom: 22px;
        }

        .features li {
            color: #555;
            font-size: 14px;
            margin: 11px 0;
        }

        .features li::before {
            content: "✓";
            color: #d62f83;
            font-weight: bold;
            margin-right: 8px;
        }

        .book-btn {
            display: block;
            text-align: center;
            background: #d62f83;
            color: white;
            text-decoration: none;
            padding: 11px;
            border-radius: 8px;
            font-weight: bold;
        }

        .book-btn:hover {
            background: #b9236d;
        }

        /* CUSTOM PACKAGE */

        .custom {
            width: 90%;
            max-width: 1000px;
            margin: 0 auto 70px;
            padding: 40px;
            background: white;
            text-align: center;
            border-radius: 16px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
        }

        .custom h2 {
            color: #d62f83;
            margin-bottom: 12px;
        }

        .custom p {
            color: #666;
            margin-bottom: 22px;
        }

        .custom-btn {
            display: inline-block;
            background: #d62f83;
            color: white;
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 25px;
            font-weight: bold;
        }

        /* CTA */

        .cta {
            background: #d62f83;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .cta h2 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .cta p {
            margin-bottom: 22px;
        }

        .cta-btn {
            display: inline-block;
            background: white;
            color: #d62f83;
            padding: 12px 28px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: bold;
        }

        /* RESPONSIVE */

        @media (max-width: 1000px) {
            .packages {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 32px;
            }

            .packages {
                grid-template-columns: 1fr;
            }

            .custom {
                padding: 28px;
            }
        }
    </style>
</head>

<body>

    <!-- HERO -->

    <section class="hero">

        <h1>Wedding Packages 💍</h1>

        <p>
            Choose a complete wedding package designed to make
            your special day beautiful, memorable and stress-free.
        </p>

    </section>


    <!-- PACKAGES -->

    <section class="packages">

        <!-- BASIC -->

        <div class="package-card">

            <img
                src="/images/wedding-basic.jpg"
                alt="Basic Wedding Package"
            >

            <div class="package-content">

                <h2>Classic Wedding</h2>

                <div class="price">
                    ₹49,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Basic Venue Decoration</li>
                    <li>Wedding Catering</li>
                    <li>Basic Photography</li>
                    <li>Floral Decoration</li>
                    <li>DJ & Sound System</li>
                </ul>

                <a
                    href="/book-now?package=classic-wedding"
                    class="book-btn"
                >
                    Book Now
                </a>

            </div>

        </div>


        <!-- PREMIUM -->

        <div class="package-card">

            <div class="popular">
                MOST POPULAR
            </div>

            <img
                src="/images/wedding-premium.jpg"
                alt="Premium Wedding Package"
            >

            <div class="package-content">

                <h2>Premium Wedding</h2>

                <div class="price">
                    ₹99,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Premium Venue Decoration</li>
                    <li>Full Catering Service</li>
                    <li>Professional Photography</li>
                    <li>Professional Videography</li>
                    <li>DJ & Entertainment</li>
                    <li>Bridal Entry Setup</li>
                </ul>

                <a
                    href="/book-now?package=premium-wedding"
                    class="book-btn"
                >
                    Book Now
                </a>

            </div>

        </div>


        <!-- LUXURY -->

        <div class="package-card">

            <img
                src="/images/wedding-luxury.jpg"
                alt="Luxury Wedding Package"
            >

            <div class="package-content">

                <h2>Royal Wedding</h2>

                <div class="price">
                    ₹1,99,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Luxury Wedding Venue</li>
                    <li>Grand Decoration</li>
                    <li>Premium Catering</li>
                    <li>Photo & Cinematic Video</li>
                    <li>Live Music</li>
                    <li>Special Couple Entry</li>
                    <li>Complete Event Management</li>
                </ul>

                <a
                    href="/book-now?package=royal-wedding"
                    class="book-btn"
                >
                    Book Now
                </a>

            </div>

        </div>


        <!-- DESTINATION -->

        <div class="package-card">

            <img
                src="/images/destination-wedding.jpg"
                alt="Destination Wedding Package"
            >

            <div class="package-content">

                <h2>Destination Wedding</h2>

                <div class="price">
                    ₹2,99,999 <span>/ package</span>
                </div>

                <ul class="features">
                    <li>Destination Venue</li>
                    <li>Guest Accommodation</li>
                    <li>Luxury Decoration</li>
                    <li>Premium Catering</li>
                    <li>Photography & Videography</li>
                    <li>Entertainment</li>
                    <li>Event Management</li>
                </ul>

                <a
                    href="/book-now?package=destination-wedding"
                    class="book-btn"
                >
                    Book Now
                </a>

            </div>

        </div>

    </section>


    <!-- CUSTOM PACKAGE -->

    <section class="custom">

        <h2>Create Your Custom Wedding Package ❤️</h2>

        <p>
            Choose your own venue, decoration, catering,
            photography and entertainment according to your budget.
        </p>

        <a href="/custom-package" class="custom-btn">
            Create Custom Package
        </a>

    </section>


    <!-- CTA -->

    <section class="cta">

        <h2>Let's Make Your Wedding Unforgettable 💕</h2>

        <p>
            Choose a package and start planning your dream wedding today.
        </p>

        <a href="/book-now" class="cta-btn">
            Start Booking
        </a>

    </section>

</body>
</html>