<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Musical Moments</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body {
      background: #f9f9f9;
      font-family: 'Poppins', sans-serif;
    }

    .container {
      margin-top: 50px;
    }

    h1 {
      text-align: center;
      font-weight: bold;
      margin-bottom: 40px;
      color: #333;
    }

    .card {
      border: none;
      border-radius: 15px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: transform 0.3s ease;
      height: 100%;
      background: #fff;
    }

    .card:hover {
      transform: scale(1.03);
    }

    .card video {
      width: 100%;
      height: 200px;
      border-top-left-radius: 15px;
      border-top-right-radius: 15px;
      object-fit: cover;
    }

    .card-body {
      padding: 15px;
      background: white;
      border-bottom-left-radius: 15px;
      border-bottom-right-radius: 15px;
    }

    .card-title {
      font-weight: 600;
      color: #222;
      margin-bottom: 10px;
    }

    .card-text {
      color: #555;
      font-size: 0.9rem;
      margin-bottom: 8px;
    }

    .btn-cart {
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 8px;
      padding: 8px 16px;
      transition: background 0.3s;
      width: 100%;
      font-weight: 500;
    }

    .btn-cart:hover {
      background-color: #0056b3;
    }

    .no-data {
      text-align: center;
      color: #888;
      font-size: 1.2rem;
      margin-top: 30px;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>🎶 Musical Moments</h1>

    <div class="row">
      <% if (musicalList.length === 0) { %>
        <p class="no-data">No musical services available right now.</p>
      <% } else { %>
        <% musicalList.forEach(music => { %>
          <div class="col-md-4 mb-4">
            <div class="card">
              <!-- 🎥 Video Section -->
              <video autoplay muted loop playsinline poster="/assets/default-thumbnail.jpg">
                <source src="<%= music.video_url || '/assets/default-music.mp4' %>" type="video/mp4">
                Your browser does not support the video tag.
              </video>

              <div class="card-body">
                <h5 class="card-title"><%= music.name %></h5>
                <p class="card-text"><%= (music.information || "No description available").substring(0, 80) %>...</p>
                <p><strong>Location:</strong> <%= music.address || "Not available" %></p>
                <p><strong>Rating:</strong> ⭐ <%= music.rating || "N/A" %></p>
                <p><strong>Contact:</strong> <%= music.phone || "Not available" %></p>
                <p><strong>Price:</strong> ₹<%= music.price || 5000 %></p>

                <!-- 🛒 Add to Cart -->
                <form action="/add-to-cart" method="POST" class="mt-2">
                  <input type="hidden" name="id" value="<%= music.id %>">
                  <input type="hidden" name="name" value="<%= music.name %>">
                  <input type="hidden" name="price" value="<%= music.price || 55000 %>">
                  <input type="hidden" name="type" value="musical">
                  <button type="submit" class="btn-cart">Add to Cart</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

</body>
</html>
